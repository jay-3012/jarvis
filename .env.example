# Jarvis Environment Configuration
# Copy this file to .env and update with your values

# ===== Application Settings =====
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ===== Security =====
SECRET_KEY=your-secret-key-change-this-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=720  # 30 days

# ===== Database Configuration =====
DATABASE_URL=postgresql://jarvis:jarvis_password@localhost:5432/jarvis
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ===== Redis Configuration =====
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ===== Ollama Configuration =====
OLLAMA_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=60

# ===== ChromaDB Configuration =====
CHROMADB_URL=http://localhost:8002
CHROMADB_COLLECTION=jarvis_files

# ===== Central Server =====
CENTRAL_SERVER_HOST=0.0.0.0
CENTRAL_SERVER_PORT=8000
WEBSOCKET_PORT=8001

# ===== Device Configuration (for Desktop Agent) =====
DEVICE_ID=windows-laptop
DEVICE_TYPE=desktop
DEVICE_NAME=Windows Laptop

# ===== Voice Configuration =====
STT_MODEL_PATH=./models/sherpa-onnx-streaming-zipformer-bilingual-zh-en-2023-02-20
TTS_MODEL_PATH=./models/en_US-lessac-medium.onnx
VOICE_SAMPLE_RATE=16000

# ===== File Indexing =====
FILE_INDEX_ENABLED=true
FILE_INDEX_INTERVAL=300  # seconds
FILE_INDEX_EXCLUDE_PATTERNS=node_modules,venv,.git,__pycache__

# ===== Monitoring =====
ENABLE_METRICS=true
METRICS_PORT=9090

# ===== CORS Settings =====
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# ===== Task Queue =====
TASK_QUEUE_NAME=jarvis_tasks
TASK_QUEUE_MAX_RETRIES=3
TASK_QUEUE_RETRY_DELAY=5

# ===== Logging =====
LOG_FORMAT=json
LOG_FILE=logs/jarvis.log
LOG_ROTATION=1 day
LOG_RETENTION=30 days

# Central Device Configuration
IS_CENTRAL_DEVICE=true
CENTRAL_DEVICE_ID=central-hub
DEVICE_TYPE=desktop
DEVICE_NAME=Central Hub
